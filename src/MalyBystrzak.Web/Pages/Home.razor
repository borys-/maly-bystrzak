@page "/"
@using System.Security.Cryptography
@using System.Text.Json
@using MalyBystrzak.Web.Components
@inject BookGenerator Generator
@inject WorksheetModuleRegistry Registry
@inject PdfExportService PdfExporter
@inject IProjectStore ProjectStore
@inject IJSRuntime JS

<PageTitle>Łamigłówki dla dzieci do druku – generator PDF | Mały Bystrzak</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">NAUKA, KTÓRA TRAFIA NA PAPIER</span>
        <h1>Stwórz łamigłówki dla dzieci<br /><em>do druku w PDF.</em></h1>
        <p>Ułóż bezpłatną książeczkę z Sudoku, łamigłówkami matematycznymi, szyframi, labiryntami i zadaniami słownymi. Wybierz poziom i pobierz gotowe karty pracy — bez konta i wysyłania danych.</p>
        <div class="hero-pills" aria-label="Najważniejsze możliwości">
            <span>Sudoku i Kakuro</span><span>Zagadki matematyczne</span><span>Szyfry i ścieżki słowne</span><span>Gotowa broszura A4</span>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="paper-card paper-back"></div>
        <div class="paper-card paper-front">
            <span>MAŁY</span><strong>BYSTRZAK</strong>
            <div class="mini-grid">@foreach (var n in new[] { "1", "", "", "4", "", "4", "1", "", "", "1", "4", "", "4", "", "", "1" }) { <i>@n</i> }</div>
        </div>
        <i class="shape shape-one"></i><i class="shape shape-two"></i><i class="shape shape-three"></i>
    </div>
</section>

<section class="builder-section" id="generator">
    <div class="section-heading">
        <div><span class="step-label">KROK PO KROKU</span><h2>Zaprojektuj książeczkę</h2></div>
        <p>Wszystkie ustawienia możesz później zapisać na tym urządzeniu.</p>
    </div>

    <div class="builder-grid">
        <form class="config-card" @onsubmit="GenerateAsync" @onsubmit:preventDefault>
            <fieldset>
                <legend><b>1</b> Wybierz rodzaje zadań</legend>
                <div class="variant-grid">
                    @foreach (var choice in choices)
                    {
                        <label class="variant-option @(choice.Selected ? "selected" : null)" data-testid="@($"variant-{choice.ModuleId}-{choice.VariantId}")">
                            <input type="checkbox" @bind="choice.Selected" />
                            <span class="variant-icon">@choice.Symbol</span>
                            <span><strong>@choice.Name</strong><small>@choice.Description</small></span>
                            <i aria-hidden="true">✓</i>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset>
                <legend><b>2</b> Dopasuj książeczkę</legend>
                <div class="form-grid">
                    <label><span>Tytuł</span><input maxlength="70" @bind="title" @bind:event="oninput" /></label>
                    <label><span>Imię dziecka <small>(opcjonalnie)</small></span><input maxlength="40" @bind="childName" @bind:event="oninput" placeholder="np. Zosia" /></label>
                    <label class="wide"><span>Podtytuł</span><input maxlength="100" @bind="subtitle" @bind:event="oninput" /></label>
                    <label><span>Liczba zadań</span><input type="number" min="1" max="180" @bind="count" @bind:event="oninput" /></label>
                    <label><span>Ziarno zestawu</span><span class="input-action"><input type="number" @bind="seed" @bind:event="oninput" /><button type="button" @onclick="RandomizeSeed" title="Wylosuj ziarno">↻</button></span></label>
                </div>
                @if (ConfigurationLayoutAdvice is { } advice)
                {
                    <div class="layout-advice" data-testid="layout-advice">
                        <span class="layout-advice-icon" aria-hidden="true">◇</span>
                        <div>
                            <p><strong>W książeczce zostanie sporo wolnego miejsca.</strong> Szacowane wykorzystanie stron: @advice.Estimate.UtilizationPercentage%.</p>
                            <span class="layout-usage" aria-hidden="true"><i style="width:@advice.Estimate.UtilizationPercentage%"></i></span>
                            @if (advice.SuggestedCount is { } suggestedCount)
                            {
                                <small>Ustaw @suggestedCount zadań, aby zapełnić całe strony.</small>
                            }
                            else
                            {
                                <small>Wybrane rozmiary zadań nie wypełniają całej strony przy tej liczbie. Dodaj zadania albo zmień zestaw typów.</small>
                            }
                        </div>
                        @if (advice.SuggestedCount is { } targetCount)
                        {
                            <button type="button" data-testid="apply-layout-suggestion" @onclick="() => count = targetCount">Ustaw @targetCount</button>
                        }
                    </div>
                }
                <label class="toggle-row"><input type="checkbox" @bind="personalized" /><span><strong>Personalizuj zakres trudności</strong><small>Wynik 0–100 jest percentylem porównywalnym między rodzajami zadań.</small></span></label>
                @if (personalized)
                {
                    <div class="range-row">
                        <label><span>Od</span><input type="number" min="0" max="99" @bind="scoreMin" @bind:event="oninput" /></label>
                        <span>—</span>
                        <label><span>Do</span><input type="number" min="1" max="100" @bind="scoreMax" @bind:event="oninput" /></label>
                    </div>
                }
                <label class="toggle-row"><input type="checkbox" @bind="includeSolutions" /><span><strong>Dołącz rozwiązania</strong><small>Odpowiedzi znajdą się w osobnej sekcji na końcu.</small></span></label>
                <label class="toggle-row"><input data-testid="ink-saving-mode" type="checkbox" @bind="inkSavingMode" /><span><strong>Oszczędny druk czarno-biały</strong><small>PDF bez kolorowych wypełnień — czytelny i łagodniejszy dla tuszu.</small></span></label>
            </fieldset>

            @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert error" role="alert">@error</div> }
            @if (isGenerating)
            {
                <div class="progress-box" aria-live="polite">
                    <div><span>@progressMessage</span><strong>@progressPercent%</strong></div>
                    <progress max="100" value="@progressPercent"></progress>
                    <button type="button" class="text-button" @onclick="CancelGeneration">Anuluj generowanie</button>
                </div>
            }
            else
            {
                <button class="primary-button" type="submit" data-testid="generate"><span>Wygeneruj książeczkę</span><b>→</b></button>
            }
            <button class="share-button" type="button" data-testid="share-configuration" @onclick="ShareConfigurationAsync">Skopiuj link do ustawień</button>
            @if (book is null && !string.IsNullOrWhiteSpace(message)) { <div class="alert success" role="status">@message</div> }
        </form>

        <aside class="result-card" data-testid="@(book is null ? "empty-result" : "result")">
            @if (book is null)
            {
                <div class="empty-result">
                    <div class="empty-icon">✦</div>
                    <h3>Tu pojawi się Twoja książeczka</h3>
                    <p>Wybierz ustawienia i rozpocznij generowanie. Zobaczysz pierwsze zadania jeszcze przed pobraniem.</p>
                </div>
            }
            else
            {
                <div class="result-heading">
                    <div><span>GOTOWE DO DRUKU</span><h3>@book.Settings.Title</h3></div>
                    <span class="success-chip">✓ @book.Worksheets.Count zadań</span>
                </div>
                <div class="preview-toolbar">
                    <div class="preview-tabs" aria-label="Rodzaj podglądu">
                        <button type="button" class="@(!showingSolutions ? "active" : null)" data-testid="preview-tasks" @onclick="() => showingSolutions = false">Zadania</button>
                        <button type="button" class="@(showingSolutions ? "active" : null)" data-testid="preview-solutions" @onclick="() => showingSolutions = true">Rozwiązania</button>
                    </div>
                    <span class="preview-status">
                        @if (inkSavingMode) { <b data-testid="monochrome-preview-label">CZARNO-BIAŁY</b> }
                        <span data-testid="preview-page-label">Strona @(previewPage + 1) z @PreviewPageCount</span>
                    </span>
                </div>
                <div class="preview-grid @(inkSavingMode ? "ink-saving-preview" : null)">
                    @foreach (var placement in PreviewItems)
                    {
                        var item = placement.Worksheet;
                        <article class="preview-card @(item.Layout == WorksheetLayout.Standard ? null : "large") layout-@item.Layout.ToString().ToLowerInvariant()"
                                 style="grid-column:@(placement.Column + 1) / span @placement.ColumnSpan; grid-row:@(placement.Row + 1) / span @placement.RowSpan">
                            <header>
                                <strong>Nr @item.Number</strong><span>@item.TypeName</span>
                                <span class="worksheet-actions">
                                    <button type="button" title="Przesuń wcześniej" aria-label="Przesuń zadanie @item.Number wcześniej"
                                            disabled="@(item.Number == 1 || regeneratingWorksheet is not null)" @onclick="() => MoveWorksheet(item.Number, -1)">↑</button>
                                    <button type="button" title="Przesuń później" aria-label="Przesuń zadanie @item.Number później"
                                            disabled="@(item.Number == book.Worksheets.Count || regeneratingWorksheet is not null)" @onclick="() => MoveWorksheet(item.Number, 1)">↓</button>
                                    <button type="button" class="regenerate-button" data-testid="regenerate-worksheet" title="Wylosuj nowe zadanie"
                                            aria-label="Regeneruj zadanie @item.Number" disabled="@(regeneratingWorksheet is not null)"
                                            @onclick="() => RegenerateWorksheetAsync(item.Number)">@(regeneratingWorksheet == item.Number ? "…" : "↻")</button>
                                </span>
                            </header>
                            <WorksheetPreview Visual="@(showingSolutions ? item.Solution : item.Task)"
                                              Label="@($"{(showingSolutions ? "Rozwiązanie" : "Zadanie")} {item.Number} — {item.TypeName}")" />
                            <footer><span class="difficulty-dots">@Dots(item.DisplayStars)</span><small>@item.Difficulty.Score/100</small></footer>
                        </article>
                    }
                </div>
                <div class="preview-pagination">
                    <button type="button" data-testid="preview-previous" disabled="@(previewPage == 0)" @onclick="PreviousPreviewPage">← Poprzednia</button>
                    <button type="button" data-testid="preview-next" disabled="@(previewPage + 1 >= PreviewPageCount)" @onclick="NextPreviewPage">Następna →</button>
                </div>
                @if (SuggestedFullPageCount is { } suggestedCount)
                {
                    <div class="page-fill-hint" data-testid="page-fill-hint">
                        <span aria-hidden="true">▦</span>
                        <p><strong>W broszurce zostało wolne miejsce.</strong> Możesz zwiększyć liczbę zadań do @suggestedCount bez dodawania kolejnych kartek.</p>
                        <button type="button" @onclick="() => ApplySuggestedCount(suggestedCount)">Ustaw @suggestedCount</button>
                    </div>
                }
                <div class="download-stack">
                    <button class="primary-button" data-testid="download-booklet" @onclick="DownloadBookletAsync" disabled="@isExporting"><span>@(isExporting ? "Przygotowuję PDF…" : "Pobierz broszurę A4")</span><b>↓</b></button>
                    <div class="secondary-actions">
                        <button @onclick="DownloadPreviewAsync" disabled="@isExporting">Podgląd A5</button>
                        <button data-testid="download-solutions" @onclick="DownloadSolutionsAsync" disabled="@isExporting">Same rozwiązania</button>
                        <button data-testid="difficulty-report" @onclick="OpenDifficultyReport">Raport trudności</button>
                    </div>
                </div>
                @if (isExporting)
                {
                    <div class="progress-box export-progress" aria-live="polite">
                        <div><span>@exportProgressMessage</span><strong>@exportProgressPercent%</strong></div>
                        <progress max="100" value="@exportProgressPercent"></progress>
                    </div>
                }
                <div class="save-project">
                    <input aria-label="Nazwa projektu" maxlength="60" @bind="projectName" />
                    <button data-testid="save-project" @onclick="SaveProjectAsync">@(activeProjectId is null ? "Zapisz projekt" : "Nadpisz projekt")</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert success" role="status">@message</div> }
            }
        </aside>
    </div>
</section>

<section class="seo-info-section" id="o-generatorze" aria-labelledby="seo-info-title">
    <div class="seo-info-heading">
        <span class="step-label">NAUKA PRZEZ ZABAWĘ</span>
        <h2 id="seo-info-title">Karty pracy dla rodziców i nauczycieli</h2>
        <p>Mały Bystrzak pomaga szybko przygotować łamigłówki dla dzieci do druku. Każdą książeczkę możesz dopasować, zapisać i pobrać jako czytelny PDF.</p>
    </div>
    <div class="puzzle-info-grid">
        <article><span>#</span><h3>Sudoku</h3><p>Plansze 4×4 i 6×6 uczą dostrzegania zależności oraz spokojnego rozwiązywania problemów.</p></article>
        <article><span>+</span><h3>Kakuro</h3><p>Proste zadania z sumami łączą logiczne myślenie z ćwiczeniem podstawowych obliczeń.</p></article>
        <article><span>↝</span><h3>Labirynty</h3><p>Trasy 9×9 i 15×15 wspierają koncentrację, planowanie i spostrzegawczość.</p></article>
        <article><span>▦</span><h3>Nonogramy</h3><p>Obrazki 5×5, 7×7 i 10×10 pozwalają stopniowo zwiększać poziom wyzwania.</p></article>
    </div>
    <div class="audience-info-grid">
        <article><h3>Do nauki w domu</h3><p>Rodzice mogą przygotować spersonalizowaną książeczkę na spokojne popołudnie, podróż lub dodatkowe ćwiczenia.</p></article>
        <article><h3>Na zajęcia i do świetlicy</h3><p>Nauczyciele otrzymują gotowe karty pracy z odpowiedziami, które można wydrukować w kolorze albo w oszczędnym trybie czarno-białym.</p></article>
    </div>
    <div class="faq-section" aria-labelledby="faq-title">
        <h2 id="faq-title">Najczęstsze pytania</h2>
        <div class="faq-grid">
            <article><h3>Czy generator Mały Bystrzak jest bezpłatny?</h3><p>Tak. Generator jest bezpłatny i nie wymaga zakładania konta.</p></article>
            <article><h3>Czy dane dziecka są wysyłane na serwer?</h3><p>Nie. Książeczki i zapisane projekty powstają lokalnie w przeglądarce użytkownika.</p></article>
            <article><h3>Jakie zadania można dodać do książeczki?</h3><p>Do wyboru są Sudoku, Kakuro, labirynty i nonogramy w kilku rozmiarach oraz osobna sekcja rozwiązań.</p></article>
        </div>
    </div>
</section>

<section class="projects-section" id="projekty">
    <div class="section-heading">
        <div><span class="step-label">NA TYM URZĄDZENIU</span><h2>Zapisane projekty</h2></div>
        <p>Dane pozostają wyłącznie w tej przeglądarce.</p>
    </div>
    @if (projects.Count == 0)
    {
        <div class="projects-empty">Nie masz jeszcze zapisanych projektów.</div>
    }
    else
    {
        <div class="project-list">
            @foreach (var project in projects)
            {
                <article>
                    <div class="project-badge">@project.WorksheetCount</div>
                    <div><strong>@project.Name</strong><small>@project.UpdatedAt.LocalDateTime.ToString("dd.MM.yyyy, HH:mm") · @project.WorksheetCount zadań</small></div>
                    <button data-testid="open-project" @onclick="() => LoadProjectAsync(project.Id)">Otwórz</button>
                    <button data-testid="delete-project" class="delete-button" title="Usuń projekt" @onclick="() => DeleteProjectAsync(project.Id)">×</button>
                </article>
            }
        </div>
    }
</section>

@if (showingDifficultyReport && book is not null)
{
    <div class="report-modal-backdrop" @onclick="CloseDifficultyReport">
        <section class="report-modal" role="dialog" aria-modal="true" aria-labelledby="report-title"
                 data-testid="difficulty-report-panel" @onclick:stopPropagation="true">
            <header class="report-modal-header">
                <div>
                    <span class="step-label">ANALIZA KSIĄŻECZKI</span>
                    <h2 id="report-title">Raport trudności</h2>
                    <p>@book.Settings.Title · @book.Worksheets.Count zadań</p>
                </div>
                <button class="report-close" data-testid="difficulty-report-close" @onclick="CloseDifficultyReport" aria-label="Zamknij raport">×</button>
            </header>
            <div class="report-overview">
                <article><span>Średni wynik</span><strong>@DifficultyAverage<small>/100</small></strong><i class="score-line"><b style="width:@DifficultyAverage%"></b></i></article>
                <article><span>Zakres trudności</span><strong>@DifficultyMinimum–@DifficultyMaximum</strong><small>od najłatwiejszego do najtrudniejszego</small></article>
                <article><span>Liczba zadań</span><strong>@book.Worksheets.Count</strong><small>@DifficultyTypeCount rodzajów w książeczce</small></article>
            </div>
            <div class="report-legend">
                <span><b>Luka</b> ile informacji trzeba samodzielnie odkryć</span>
                <span><b>Wybór</b> liczba możliwych decyzji</span>
                <span><b>Reguły</b> obciążenie zależnościami</span>
                <span><b>Pamięć</b> ile trzeba utrzymać w głowie</span>
                <span><b>Rachunki</b> udział obliczeń</span>
            </div>
            <div class="report-table-wrap">
                <table>
                    <thead><tr><th>Nr</th><th>Zadanie</th><th>Wynik</th><th>Poziom</th><th>Luka</th><th>Wybór</th><th>Reguły</th><th>Pamięć</th><th>Rachunki</th></tr></thead>
                    <tbody>
                        @foreach (var worksheet in book.Worksheets.OrderBy(item => item.Number))
                        {
                            <tr>
                                <td><span class="report-number">@worksheet.Number</span></td>
                                <td><strong class="report-type">@worksheet.TypeName</strong></td>
                                <td><span class="score-badge score-@ScoreBand(worksheet.Difficulty.Score)">@worksheet.Difficulty.Score</span></td>
                                <td><span class="report-stars">@Dots(worksheet.DisplayStars)</span><small class="level-label">@worksheet.Difficulty.Label</small></td>
                                <td>@worksheet.Difficulty.InformationGap</td><td>@worksheet.Difficulty.ChoiceLoad</td>
                                <td>@worksheet.Difficulty.ConstraintLoad</td><td>@worksheet.Difficulty.WorkingMemoryLoad</td>
                                <td>@worksheet.Difficulty.ArithmeticLoad</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="report-modal-footer">
                <span>Wynik 0–100 pozwala porównywać zadania w tej książeczce.</span>
                <button @onclick="CloseDifficultyReport">Gotowe</button>
            </footer>
        </section>
    </div>
}

@code {
    private readonly List<VariantChoice> choices = [];
    private IReadOnlyList<ProjectSummary> projects = [];
    private GeneratedBook? book;
    private IReadOnlyList<IReadOnlyList<WorksheetPlacement>> previewPages = [];
    private Guid? activeProjectId;
    private string title = "Moja książeczka zadań";
    private string subtitle = "Łamigłówki dla małych bystrzaków";
    private string? childName;
    private string projectName = "Moja książeczka";
    private int count = 24;
    private int seed = RandomNumberGenerator.GetInt32(int.MinValue, int.MaxValue);
    private bool personalized;
    private int scoreMin = 20;
    private int scoreMax = 80;
    private bool includeSolutions;
    private bool inkSavingMode;
    private bool showingSolutions;
    private bool showingDifficultyReport;
    private int previewPage;
    private bool isGenerating;
    private bool isExporting;
    private int? regeneratingWorksheet;
    private readonly Dictionary<int, int> regenerationRounds = [];
    private int progressPercent;
    private string progressMessage = "Przygotowuję zadania…";
    private int exportProgressPercent;
    private string exportProgressMessage = "Ładuję generator PDF…";
    private string? error;
    private string? message;
    private CancellationTokenSource? cancellation;

    protected override async Task OnInitializedAsync()
    {
        foreach (var module in Registry.All)
        foreach (var variant in module.Variants)
            choices.Add(new(module.Id, variant.Id, variant.DisplayName, variant.Description, module.Symbol, variant.Layout,
                module.Id == "sudoku" && variant.Id == "4x4"));
        await RestorePreferencesAsync();
        await RestoreSharedConfigurationAsync();
        await RefreshProjectsAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = PdfExporter.WarmUpAsync();
        return Task.CompletedTask;
    }

    private async Task GenerateAsync()
    {
        error = message = null;
        var selections = choices.Where(choice => choice.Selected).Select(choice => new ModuleSelection(choice.ModuleId, choice.VariantId)).ToArray();
        if (selections.Length == 0) { error = "Wybierz co najmniej jeden rodzaj zadania."; return; }
        if (count is < 1 or > 180) { error = "Liczba zadań musi mieścić się w zakresie 1–180."; return; }
        isGenerating = true;
        progressPercent = 0;
        cancellation = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            var settings = new BookGenerationSettings(title.Trim(), subtitle.Trim(), string.IsNullOrWhiteSpace(childName) ? null : childName.Trim(),
                count, seed, selections, personalized ? scoreMin : null, personalized ? scoreMax : null, personalized, includeSolutions, inkSavingMode);
            var progress = new ImmediateProgress<GenerationProgress>(value =>
            {
                progressPercent = value.Percentage;
                progressMessage = value.Message;
                StateHasChanged();
            });
            book = await Generator.GenerateAsync(settings, progress, cancellation.Token);
            previewPages = BookLayout.PackWorksheets(book.Worksheets);
            previewPage = 0;
            showingSolutions = false;
            showingDifficultyReport = false;
            regenerationRounds.Clear();
            projectName = string.IsNullOrWhiteSpace(childName) ? title : $"{title} — {childName}";
            await JS.InvokeVoidAsync("malyBystrzak.setPreference", "last-settings", JsonSerializer.Serialize(settings));
        }
        catch (OperationCanceledException) { error = "Generowanie zostało anulowane."; }
        catch (Exception exception) { error = exception.Message; }
        finally { isGenerating = false; cancellation.Dispose(); cancellation = null; }
    }

    private void CancelGeneration() => cancellation?.Cancel();
    private void RandomizeSeed() => seed = RandomNumberGenerator.GetInt32(int.MinValue, int.MaxValue);
    private int PreviewPageCount => Math.Max(1, previewPages.Count);
    private IEnumerable<WorksheetPlacement> PreviewItems =>
        previewPages.Count == 0 ? [] : previewPages[Math.Min(previewPage, previewPages.Count - 1)];
    private void PreviousPreviewPage() => previewPage = Math.Max(0, previewPage - 1);
    private void NextPreviewPage() => previewPage = Math.Min(PreviewPageCount - 1, previewPage + 1);
    private LayoutAdvice? ConfigurationLayoutAdvice
    {
        get
        {
            if (count is < 1 or > 180) return null;
            var selected = choices.Where(choice => choice.Selected).ToArray();
            if (selected.Length == 0) return null;
            var cycle = selected.Select(choice => choice.Layout).ToArray();
            var estimate = BookLayout.EstimateWorksheetPages(count, cycle);
            if (estimate.FreeSlots == 0) return null;
            var suggestedCount = BookLayout.FindNextFullPageCount(count, cycle);
            var largeVariants = selected.Count(choice => choice.Layout == WorksheetLayout.Large);
            var smallVariants = selected.Length - largeVariants;
            var missingSmallVariants = Math.Max(1, largeVariants * 2 - smallVariants);
            return new(estimate, suggestedCount, missingSmallVariants);
        }
    }
    private int? SuggestedFullPageCount
    {
        get
        {
            if (book is null || previewPages.Count == 0) return null;
            var cycle = book.Settings.Selections.Select(selection => book.Worksheets.First(item =>
                item.ModuleId == selection.ModuleId && item.VariantId == selection.VariantId).Layout).ToArray();
            var documentPageCount = book.CreateDocument().Pages.Count;
            var worksheetSections = book.Settings.IncludeSolutions ? 2 : 1;
            var availableWorksheetPages = (documentPageCount - 2) / worksheetSections;
            return BookLayout.FindCountToFillWorksheetPages(book.Worksheets.Count, cycle, availableWorksheetPages);
        }
    }

    private async Task ApplySuggestedCount(int suggestedCount)
    {
        count = suggestedCount;
        message = $"Ustawiono {suggestedCount} zadań. Wygeneruj książeczkę ponownie, aby zapełnić strony.";
        await JS.InvokeVoidAsync("scrollTo", new { top = 520, behavior = "smooth" });
    }

    private void MoveWorksheet(int worksheetNumber, int offset)
    {
        if (book is null) return;
        var worksheets = book.Worksheets.OrderBy(item => item.Number).ToList();
        var source = worksheets.FindIndex(item => item.Number == worksheetNumber);
        var destination = source + offset;
        if (source < 0 || destination < 0 || destination >= worksheets.Count) return;
        (worksheets[source], worksheets[destination]) = (worksheets[destination], worksheets[source]);
        worksheets = worksheets.Select((item, index) => item with { Number = index + 1 }).ToList();
        book = book with { Worksheets = worksheets };
        regenerationRounds.Clear();
        RebuildPreview(worksheetNumber + offset);
        message = "Kolejność zadań została zmieniona.";
    }

    private async Task RegenerateWorksheetAsync(int worksheetNumber)
    {
        if (book is null || regeneratingWorksheet is not null) return;
        regeneratingWorksheet = worksheetNumber;
        error = message = null;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            var round = regenerationRounds.GetValueOrDefault(worksheetNumber) + 1;
            book = Generator.RegenerateWorksheet(book, worksheetNumber, round);
            regenerationRounds[worksheetNumber] = round;
            RebuildPreview(worksheetNumber);
            message = $"Zadanie nr {worksheetNumber} zostało wygenerowane ponownie.";
        }
        catch (Exception exception) { error = exception.Message; }
        finally { regeneratingWorksheet = null; }
    }

    private void RebuildPreview(int worksheetNumber)
    {
        if (book is null) return;
        previewPages = BookLayout.PackWorksheets(book.Worksheets);
        var page = previewPages.Select((items, index) => new { items, index })
            .FirstOrDefault(entry => entry.items.Any(item => item.Worksheet.Number == worksheetNumber));
        if (page is not null) previewPage = page.index;
    }
    private void OpenDifficultyReport() => showingDifficultyReport = true;
    private void CloseDifficultyReport() => showingDifficultyReport = false;
    private int DifficultyAverage => book is null ? 0 : (int)Math.Round(book.Worksheets.Average(item => item.Difficulty.Score));
    private int DifficultyMinimum => book?.Worksheets.Min(item => item.Difficulty.Score) ?? 0;
    private int DifficultyMaximum => book?.Worksheets.Max(item => item.Difficulty.Score) ?? 0;
    private int DifficultyTypeCount => book?.Worksheets.Select(item => item.TypeName).Distinct().Count() ?? 0;
    private static string ScoreBand(int score) => score switch { < 34 => "easy", < 67 => "medium", _ => "hard" };

    private async Task DownloadBookletAsync() => await DownloadPdfAsync("maly-bystrzak-broszura-a4.pdf", true);
    private async Task DownloadPreviewAsync() => await DownloadPdfAsync("maly-bystrzak-podglad-a5.pdf", false);
    private async Task DownloadSolutionsAsync()
    {
        if (book is null) return;
        await DownloadPdfAsync("maly-bystrzak-rozwiazania-a5.pdf", false, book.CreateSolutionsDocument());
    }
    private async Task DownloadPdfAsync(string name, bool booklet, BookDocument? source = null)
    {
        if (book is null) return;
        isExporting = true;
        exportProgressPercent = 0;
        exportProgressMessage = "Ładuję generator PDF…";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            var document = source ?? book.CreateDocument();
            var progress = new ImmediateProgress<GenerationProgress>(value =>
            {
                exportProgressPercent = value.Percentage;
                exportProgressMessage = value.Message;
                StateHasChanged();
            });
            var bytes = await PdfExporter.RenderAsync(document, booklet, progress);
            await JS.InvokeVoidAsync("malyBystrzak.downloadBytes", name, "application/pdf", bytes);
        }
        catch (Exception exception) { error = $"Nie udało się utworzyć PDF: {exception.Message}"; }
        finally { isExporting = false; }
    }

    private async Task SaveProjectAsync()
    {
        if (book is null || string.IsNullOrWhiteSpace(projectName)) return;
        var overwriting = activeProjectId is not null;
        activeProjectId ??= Guid.NewGuid();
        await ProjectStore.SaveAsync(new(GeneratorProject.CurrentSchemaVersion, activeProjectId.Value, projectName.Trim(), DateTimeOffset.UtcNow, book));
        message = overwriting ? "Projekt został zaktualizowany." : "Projekt został zapisany na tym urządzeniu.";
        await RefreshProjectsAsync();
    }

    private async Task LoadProjectAsync(Guid id)
    {
        var project = await ProjectStore.GetAsync(id);
        if (project is null) { error = "Nie udało się odczytać projektu."; return; }
        activeProjectId = project.Id; book = project.Book;
        previewPages = BookLayout.PackWorksheets(book.Worksheets);
        previewPage = 0; showingSolutions = false; showingDifficultyReport = false;
        ApplySettings(book.Settings);
        projectName = project.Name;
        message = "Projekt został otwarty.";
        await JS.InvokeVoidAsync("scrollTo", new { top = 520, behavior = "smooth" });
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        await ProjectStore.DeleteAsync(id);
        if (activeProjectId == id) activeProjectId = null;
        await RefreshProjectsAsync();
    }
    private async Task RefreshProjectsAsync() => projects = await ProjectStore.ListAsync();

    private async Task RestorePreferencesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("malyBystrzak.getPreference", "last-settings");
            if (!string.IsNullOrWhiteSpace(json) && JsonSerializer.Deserialize<BookGenerationSettings>(json) is { } settings)
                ApplySettings(settings, restoreSeed: false);
        }
        catch (JsonException) { }
    }

    private async Task RestoreSharedConfigurationAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("malyBystrzak.getSharedConfiguration");
            if (!string.IsNullOrWhiteSpace(json) && JsonSerializer.Deserialize<BookGenerationSettings>(json) is { } settings &&
                IsValidSharedSettings(settings))
            {
                ApplySettings(settings);
                message = "Ustawienia z udostępnionego linku są gotowe do użycia.";
            }
            else if (!string.IsNullOrWhiteSpace(json))
            {
                error = "Link z ustawieniami jest nieprawidłowy lub nieaktualny.";
            }
        }
        catch (Exception exception) when (exception is JsonException or FormatException or JSException)
        {
            error = "Link z ustawieniami jest nieprawidłowy lub nieaktualny.";
        }
    }

    private async Task ShareConfigurationAsync()
    {
        error = message = null;
        var selections = choices.Where(choice => choice.Selected)
            .Select(choice => new ModuleSelection(choice.ModuleId, choice.VariantId)).ToArray();
        if (selections.Length == 0) { error = "Wybierz co najmniej jeden rodzaj zadania."; return; }
        var settings = new BookGenerationSettings(title.Trim(), subtitle.Trim(), string.IsNullOrWhiteSpace(childName) ? null : childName.Trim(),
            count, seed, selections, personalized ? scoreMin : null, personalized ? scoreMax : null, personalized, includeSolutions, inkSavingMode);
        if (!IsValidSharedSettings(settings)) { error = "Popraw ustawienia książeczki przed skopiowaniem linku."; return; }
        var copied = await JS.InvokeAsync<bool>("malyBystrzak.copyConfigurationLink", JsonSerializer.Serialize(settings));
        message = copied ? "Link do konfiguracji został skopiowany." : "Nie udało się skopiować linku.";
    }

    private bool IsValidSharedSettings(BookGenerationSettings settings) =>
        !string.IsNullOrWhiteSpace(settings.Title) && !string.IsNullOrWhiteSpace(settings.Subtitle) &&
        settings.Count is >= 1 and <= 180 && settings.Selections is { Count: > 0 } &&
        settings.Selections.All(selection => Registry.All.Any(module =>
            module.Id == selection.ModuleId && module.Variants.Any(variant => variant.Id == selection.VariantId))) &&
        (!settings.RelativeStars || settings.Count >= 5 && settings.ScoreMinimum is >= 0 and < 100 &&
            settings.ScoreMaximum is > 0 and <= 100 && settings.ScoreMinimum < settings.ScoreMaximum);

    private void ApplySettings(BookGenerationSettings settings, bool restoreSeed = true)
    {
        title = settings.Title; subtitle = settings.Subtitle; childName = settings.ChildName;
        count = settings.Count;
        if (restoreSeed) seed = settings.Seed;
        personalized = settings.RelativeStars;
        scoreMin = settings.ScoreMinimum ?? 20; scoreMax = settings.ScoreMaximum ?? 80;
        includeSolutions = settings.IncludeSolutions;
        inkSavingMode = settings.InkSavingMode;
        foreach (var choice in choices)
            choice.Selected = settings.Selections.Contains(new(choice.ModuleId, choice.VariantId));
    }

