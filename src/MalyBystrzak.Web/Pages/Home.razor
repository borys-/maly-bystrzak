@page "/"
@using System.Security.Cryptography
@using System.Text.Json
@using MalyBystrzak.Web.Components
@inject BookGenerator Generator
@inject WorksheetModuleRegistry Registry
@inject PdfExportService PdfExporter
@inject IProjectStore ProjectStore
@inject IJSRuntime JS

<PageTitle>Mały Bystrzak — generator książeczek dla dzieci</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">NAUKA, KTÓRA TRAFIA NA PAPIER</span>
        <h1>Ułóż wyjątkową książeczkę<br /><em>dla małego bystrzaka.</em></h1>
        <p>Wybierz zadania, dopasuj poziom i pobierz gotowy PDF. Bez konta, bez wysyłania danych — także offline.</p>
        <div class="hero-pills" aria-label="Najważniejsze możliwości">
            <span>Sudoku i Kakuro</span><span>Labirynty</span><span>Nonogramy 5×5–10×10</span><span>Gotowa broszura A4</span>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="paper-card paper-back"></div>
        <div class="paper-card paper-front">
            <span>MAŁY</span><strong>BYSTRZAK</strong>
            <div class="mini-grid">@foreach (var n in new[] { "1", "", "", "4", "", "4", "1", "", "", "1", "4", "", "4", "", "", "1" }) { <i>@n</i> }</div>
        </div>
        <i class="shape shape-one"></i><i class="shape shape-two"></i><i class="shape shape-three"></i>
    </div>
</section>

<section class="builder-section" id="generator">
    <div class="section-heading">
        <div><span class="step-label">KROK PO KROKU</span><h2>Zaprojektuj książeczkę</h2></div>
        <p>Wszystkie ustawienia możesz później zapisać na tym urządzeniu.</p>
    </div>

    <div class="builder-grid">
        <form class="config-card" @onsubmit="GenerateAsync" @onsubmit:preventDefault>
            <fieldset>
                <legend><b>1</b> Wybierz rodzaje zadań</legend>
                <div class="variant-grid">
                    @foreach (var choice in choices)
                    {
                        <label class="variant-option @(choice.Selected ? "selected" : null)" data-testid="@($"variant-{choice.ModuleId}-{choice.VariantId}")">
                            <input type="checkbox" @bind="choice.Selected" />
                            <span class="variant-icon">@choice.Symbol</span>
                            <span><strong>@choice.Name</strong><small>@choice.Description</small></span>
                            <i aria-hidden="true">✓</i>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset>
                <legend><b>2</b> Dopasuj książeczkę</legend>
                <div class="form-grid">
                    <label><span>Tytuł</span><input maxlength="70" @bind="title" /></label>
                    <label><span>Imię dziecka <small>(opcjonalnie)</small></span><input maxlength="40" @bind="childName" placeholder="np. Zosia" /></label>
                    <label class="wide"><span>Podtytuł</span><input maxlength="100" @bind="subtitle" /></label>
                    <label><span>Liczba zadań</span><input type="number" min="1" max="180" @bind="count" /></label>
                    <label><span>Ziarno zestawu</span><span class="input-action"><input type="number" @bind="seed" /><button type="button" @onclick="RandomizeSeed" title="Wylosuj ziarno">↻</button></span></label>
                </div>
                <label class="toggle-row"><input type="checkbox" @bind="personalized" /><span><strong>Personalizuj zakres trudności</strong><small>Wynik 0–100 jest percentylem porównywalnym między rodzajami zadań.</small></span></label>
                @if (personalized)
                {
                    <div class="range-row">
                        <label><span>Od</span><input type="number" min="0" max="99" @bind="scoreMin" /></label>
                        <span>—</span>
                        <label><span>Do</span><input type="number" min="1" max="100" @bind="scoreMax" /></label>
                    </div>
                }
                <label class="toggle-row"><input type="checkbox" @bind="includeSolutions" /><span><strong>Dołącz rozwiązania</strong><small>Odpowiedzi znajdą się w osobnej sekcji na końcu.</small></span></label>
            </fieldset>

            @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert error" role="alert">@error</div> }
            @if (isGenerating)
            {
                <div class="progress-box" aria-live="polite">
                    <div><span>@progressMessage</span><strong>@progressPercent%</strong></div>
                    <progress max="100" value="@progressPercent"></progress>
                    <button type="button" class="text-button" @onclick="CancelGeneration">Anuluj generowanie</button>
                </div>
            }
            else
            {
                <button class="primary-button" type="submit" data-testid="generate"><span>Wygeneruj książeczkę</span><b>→</b></button>
            }
        </form>

        <aside class="result-card" data-testid="@(book is null ? "empty-result" : "result")">
            @if (book is null)
            {
                <div class="empty-result">
                    <div class="empty-icon">✦</div>
                    <h3>Tu pojawi się Twoja książeczka</h3>
                    <p>Wybierz ustawienia i rozpocznij generowanie. Zobaczysz pierwsze zadania jeszcze przed pobraniem.</p>
                </div>
            }
            else
            {
                <div class="result-heading">
                    <div><span>GOTOWE DO DRUKU</span><h3>@book.Settings.Title</h3></div>
                    <span class="success-chip">✓ @book.Worksheets.Count zadań</span>
                </div>
                <div class="preview-toolbar">
                    <div class="preview-tabs" aria-label="Rodzaj podglądu">
                        <button type="button" class="@(!showingSolutions ? "active" : null)" data-testid="preview-tasks" @onclick="() => showingSolutions = false">Zadania</button>
                        <button type="button" class="@(showingSolutions ? "active" : null)" data-testid="preview-solutions" @onclick="() => showingSolutions = true">Rozwiązania</button>
                    </div>
                    <span data-testid="preview-page-label">Strona @(previewPage + 1) z @PreviewPageCount</span>
                </div>
                <div class="preview-grid">
                    @foreach (var placement in PreviewItems)
                    {
                        var item = placement.Worksheet;
                        <article class="preview-card @(item.Layout == WorksheetLayout.Large ? "large" : null)"
                                 style="grid-column:@(placement.Column + 1) / span @placement.ColumnSpan; grid-row:@(placement.Row + 1) / span @placement.RowSpan">
                            <header><strong>Nr @item.Number</strong><span>@item.TypeName</span></header>
                            <WorksheetPreview Visual="@(showingSolutions ? item.Solution : item.Task)"
                                              Label="@($"{(showingSolutions ? "Rozwiązanie" : "Zadanie")} {item.Number} — {item.TypeName}")" />
                            <footer><span class="difficulty-dots">@Dots(item.DisplayStars)</span><small>@item.Difficulty.Score/100</small></footer>
                        </article>
                    }
                </div>
                <div class="preview-pagination">
                    <button type="button" data-testid="preview-previous" disabled="@(previewPage == 0)" @onclick="PreviousPreviewPage">← Poprzednia</button>
                    <button type="button" data-testid="preview-next" disabled="@(previewPage + 1 >= PreviewPageCount)" @onclick="NextPreviewPage">Następna →</button>
                </div>
                <div class="download-stack">
                    <button class="primary-button" data-testid="download-booklet" @onclick="DownloadBookletAsync" disabled="@isExporting"><span>@(isExporting ? "Przygotowuję PDF…" : "Pobierz broszurę A4")</span><b>↓</b></button>
                    <div class="secondary-actions">
                        <button @onclick="DownloadPreviewAsync">Podgląd A5</button>
                        <button data-testid="download-solutions" @onclick="DownloadSolutionsAsync">Same rozwiązania</button>
                        <button @onclick="DownloadCsvAsync">Raport CSV</button>
                    </div>
                </div>
                @if (isExporting)
                {
                    <div class="progress-box export-progress" aria-live="polite">
                        <div><span>@exportProgressMessage</span><strong>@exportProgressPercent%</strong></div>
                        <progress max="100" value="@exportProgressPercent"></progress>
                    </div>
                }
                <div class="save-project">
                    <input aria-label="Nazwa projektu" maxlength="60" @bind="projectName" />
                    <button data-testid="save-project" @onclick="SaveProjectAsync">@(activeProjectId is null ? "Zapisz projekt" : "Nadpisz projekt")</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert success" role="status">@message</div> }
            }
        </aside>
    </div>
</section>

<section class="projects-section" id="projekty">
    <div class="section-heading">
        <div><span class="step-label">NA TYM URZĄDZENIU</span><h2>Zapisane projekty</h2></div>
        <p>Dane pozostają wyłącznie w tej przeglądarce.</p>
    </div>
    @if (projects.Count == 0)
    {
        <div class="projects-empty">Nie masz jeszcze zapisanych projektów.</div>
    }
    else
    {
        <div class="project-list">
            @foreach (var project in projects)
            {
                <article>
                    <div class="project-badge">@project.WorksheetCount</div>
                    <div><strong>@project.Name</strong><small>@project.UpdatedAt.LocalDateTime.ToString("dd.MM.yyyy, HH:mm") · @project.WorksheetCount zadań</small></div>
                    <button data-testid="open-project" @onclick="() => LoadProjectAsync(project.Id)">Otwórz</button>
                    <button data-testid="delete-project" class="delete-button" title="Usuń projekt" @onclick="() => DeleteProjectAsync(project.Id)">×</button>
                </article>
            }
        </div>
    }
</section>

@code {
    private readonly List<VariantChoice> choices = [];
    private IReadOnlyList<ProjectSummary> projects = [];
    private GeneratedBook? book;
    private IReadOnlyList<IReadOnlyList<WorksheetPlacement>> previewPages = [];
    private Guid? activeProjectId;
    private string title = "Moja książeczka zadań";
    private string subtitle = "Łamigłówki dla małych bystrzaków";
    private string? childName;
    private string projectName = "Moja książeczka";
    private int count = 24;
    private int seed = RandomNumberGenerator.GetInt32(int.MinValue, int.MaxValue);
    private bool personalized;
    private int scoreMin = 20;
    private int scoreMax = 80;
    private bool includeSolutions;
    private bool showingSolutions;
    private int previewPage;
    private bool isGenerating;
    private bool isExporting;
    private int progressPercent;
    private string progressMessage = "Przygotowuję zadania…";
    private int exportProgressPercent;
    private string exportProgressMessage = "Ładuję generator PDF…";
    private string? error;
    private string? message;
    private CancellationTokenSource? cancellation;

    protected override async Task OnInitializedAsync()
    {
        foreach (var module in Registry.All)
        foreach (var variant in module.Variants)
            choices.Add(new(module.Id, variant.Id, variant.DisplayName, variant.Description, module.Symbol,
                module.Id == "sudoku" && variant.Id == "4x4"));
        await RestorePreferencesAsync();
        await RefreshProjectsAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = PdfExporter.WarmUpAsync();
        return Task.CompletedTask;
    }

    private async Task GenerateAsync()
    {
        error = message = null;
        var selections = choices.Where(choice => choice.Selected).Select(choice => new ModuleSelection(choice.ModuleId, choice.VariantId)).ToArray();
        if (selections.Length == 0) { error = "Wybierz co najmniej jeden rodzaj zadania."; return; }
        if (count is < 1 or > 180) { error = "Liczba zadań musi mieścić się w zakresie 1–180."; return; }
        isGenerating = true;
        progressPercent = 0;
        cancellation = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            var settings = new BookGenerationSettings(title.Trim(), subtitle.Trim(), string.IsNullOrWhiteSpace(childName) ? null : childName.Trim(),
                count, seed, selections, personalized ? scoreMin : null, personalized ? scoreMax : null, personalized, includeSolutions);
            var progress = new ImmediateProgress<GenerationProgress>(value =>
            {
                progressPercent = value.Percentage;
                progressMessage = value.Message;
                StateHasChanged();
            });
            book = await Generator.GenerateAsync(settings, progress, cancellation.Token);
            previewPages = BookLayout.PackWorksheets(book.Worksheets);
            previewPage = 0;
            showingSolutions = false;
            projectName = string.IsNullOrWhiteSpace(childName) ? title : $"{title} — {childName}";
            await JS.InvokeVoidAsync("malyBystrzak.setPreference", "last-settings", JsonSerializer.Serialize(settings));
        }
        catch (OperationCanceledException) { error = "Generowanie zostało anulowane."; }
        catch (Exception exception) { error = exception.Message; }
        finally { isGenerating = false; cancellation.Dispose(); cancellation = null; }
    }

    private void CancelGeneration() => cancellation?.Cancel();
    private void RandomizeSeed() => seed = RandomNumberGenerator.GetInt32(int.MinValue, int.MaxValue);
    private int PreviewPageCount => Math.Max(1, previewPages.Count);
    private IEnumerable<WorksheetPlacement> PreviewItems =>
        previewPages.Count == 0 ? [] : previewPages[Math.Min(previewPage, previewPages.Count - 1)];
    private void PreviousPreviewPage() => previewPage = Math.Max(0, previewPage - 1);
    private void NextPreviewPage() => previewPage = Math.Min(PreviewPageCount - 1, previewPage + 1);

    private async Task DownloadBookletAsync() => await DownloadPdfAsync("maly-bystrzak-broszura-a4.pdf", true);
    private async Task DownloadPreviewAsync() => await DownloadPdfAsync("maly-bystrzak-podglad-a5.pdf", false);
    private async Task DownloadSolutionsAsync()
    {
        if (book is null) return;
        await DownloadPdfAsync("maly-bystrzak-rozwiazania-a5.pdf", false, book.CreateSolutionsDocument());
    }
    private async Task DownloadPdfAsync(string name, bool booklet, BookDocument? source = null)
    {
        if (book is null) return;
        isExporting = true;
        exportProgressPercent = 0;
        exportProgressMessage = "Ładuję generator PDF…";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            var document = source ?? book.CreateDocument();
            var progress = new ImmediateProgress<GenerationProgress>(value =>
            {
                exportProgressPercent = value.Percentage;
                exportProgressMessage = value.Message;
                StateHasChanged();
            });
            var bytes = await PdfExporter.RenderAsync(document, booklet, progress);
            await JS.InvokeVoidAsync("malyBystrzak.downloadBytes", name, "application/pdf", bytes);
        }
        catch (Exception exception) { error = $"Nie udało się utworzyć PDF: {exception.Message}"; }
        finally { isExporting = false; }
    }

    private async Task DownloadCsvAsync()
    {
        if (book is null) return;
        await JS.InvokeVoidAsync("malyBystrzak.downloadBytes", DifficultyReport.FileName, "text/csv", DifficultyReport.Create(book.Worksheets));
    }

    private async Task SaveProjectAsync()
    {
        if (book is null || string.IsNullOrWhiteSpace(projectName)) return;
        var overwriting = activeProjectId is not null;
        activeProjectId ??= Guid.NewGuid();
        await ProjectStore.SaveAsync(new(GeneratorProject.CurrentSchemaVersion, activeProjectId.Value, projectName.Trim(), DateTimeOffset.UtcNow, book));
        message = overwriting ? "Projekt został zaktualizowany." : "Projekt został zapisany na tym urządzeniu.";
        await RefreshProjectsAsync();
    }

    private async Task LoadProjectAsync(Guid id)
    {
        var project = await ProjectStore.GetAsync(id);
        if (project is null) { error = "Nie udało się odczytać projektu."; return; }
        activeProjectId = project.Id; book = project.Book;
        previewPages = BookLayout.PackWorksheets(book.Worksheets);
        previewPage = 0; showingSolutions = false;
        ApplySettings(book.Settings);
        projectName = project.Name;
        message = "Projekt został otwarty.";
        await JS.InvokeVoidAsync("scrollTo", new { top = 520, behavior = "smooth" });
    }

    private async Task DeleteProjectAsync(Guid id)
    {
        await ProjectStore.DeleteAsync(id);
        if (activeProjectId == id) activeProjectId = null;
        await RefreshProjectsAsync();
    }
    private async Task RefreshProjectsAsync() => projects = await ProjectStore.ListAsync();

    private async Task RestorePreferencesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("malyBystrzak.getPreference", "last-settings");
            if (!string.IsNullOrWhiteSpace(json) && JsonSerializer.Deserialize<BookGenerationSettings>(json) is { } settings)
                ApplySettings(settings, restoreSeed: false);
        }
        catch (JsonException) { }
    }

    private void ApplySettings(BookGenerationSettings settings, bool restoreSeed = true)
    {
        title = settings.Title; subtitle = settings.Subtitle; childName = settings.ChildName;
        count = settings.Count;
        if (restoreSeed) seed = settings.Seed;
        personalized = settings.RelativeStars;
        scoreMin = settings.ScoreMinimum ?? 20; scoreMax = settings.ScoreMaximum ?? 80;
        includeSolutions = settings.IncludeSolutions;
        foreach (var choice in choices)
            choice.Selected = settings.Selections.Contains(new(choice.ModuleId, choice.VariantId));
    }

    private static string Dots(int count) => new('●', count);

    private sealed class VariantChoice(string moduleId, string variantId, string name, string description, string symbol, bool selected)
    {
        public string ModuleId { get; } = moduleId;
        public string VariantId { get; } = variantId;
        public string Name { get; } = name;
        public string Description { get; } = description;
        public string Symbol { get; } = symbol;
        public bool Selected { get; set; } = selected;
    }

    private sealed class ImmediateProgress<T>(Action<T> report) : IProgress<T>
    {
        public void Report(T value) => report(value);
    }
}
